{
  "name": "@odinscode/carbide-home",
  "version": "0.9.2",
  "description": "Carbide UI home components for React: HomeShell, navigation and dashboard",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@odinscode/carbide-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "keywords": [
    "carbide-ui",
    "react",
    "dashboard",
    "home"
  ],
  "author": "Vitali Wottschel",
  "homepage": "https://showcase.growdog.tech/carbide-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odinscode-dev/carbide-ui.git",
    "directory": "packages/home"
  },
  "bugs": {
    "url": "https://github.com/odinscode-dev/carbide-ui/issues"
  }
}
