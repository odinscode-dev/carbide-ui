{
  "name": "@odinscode/carbide-shell",
  "version": "1.8.3",
  "description": "Carbide UI page shells for React: AdminShell, BoardShell, FieldShell, list and object pages",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ark-ui/react": "^5.30.0",
    "@odinscode/carbide-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "keywords": [
    "carbide-ui",
    "dashboard",
    "design-system",
    "layout",
    "react",
    "shell"
  ],
  "author": "Vitali Wottschel",
  "homepage": "https://showcase.growdog.tech/carbide-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odinscode-dev/carbide-ui.git",
    "directory": "packages/shell"
  },
  "bugs": {
    "url": "https://github.com/odinscode-dev/carbide-ui/issues"
  }
}
