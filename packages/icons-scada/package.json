{
  "name": "@odinscode/carbide-icons-scada",
  "version": "1.3.2",
  "description": "Carbide UI plant symbols for React: pumps, valves, tanks, piping and displays with states",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@odinscode/carbide-token": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "keywords": [
    "carbide-ui",
    "design-system",
    "hmi",
    "icons",
    "react",
    "scada",
    "svg"
  ],
  "author": "Vitali Wottschel",
  "homepage": "https://showcase.growdog.tech/carbide-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odinscode-dev/carbide-ui.git",
    "directory": "packages/icons-scada"
  },
  "bugs": {
    "url": "https://github.com/odinscode-dev/carbide-ui/issues"
  }
}
