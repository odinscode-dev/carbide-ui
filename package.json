{
  "name": "carbide-ui",
  "version": "0.1.0",
  "description": "Komponentenbibliothek für Leitstand-, Verwaltungs- und Feldanwendungen",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r build && tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "build-storybook": "storybook build -o dist-storybook",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@changesets/cli": "^3.0.3",
    "@odinscode/biome-config": "^0.3.0",
    "@odinscode/tsconfig": "^0.3.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.0",
    "vitest": "^3.0.0"
  }
}
